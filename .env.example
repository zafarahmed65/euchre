# Local dev uses SQLite (no server needed).
# To switch to Neon/Postgres, set DATABASE_URI to a postgres:// connection string —
# src/payload.config.ts picks the adapter automatically.
DATABASE_URI=file:./midwest-euchre.db
PAYLOAD_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
VOTE_SALT=replace-with-a-random-salt

# Seed logins — set these in any deployed environment.
SEED_OWNER_EMAIL=owner@midwesteuchreco.com
SEED_OWNER_PASSWORD=replace-with-a-strong-password
SEED_EDITOR_EMAIL=editor@midwesteuchreco.com
SEED_EDITOR_PASSWORD=replace-with-a-strong-password
